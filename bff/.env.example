# Banco do BFF (Postgres). Em dev, cai para SQLite se não for definido.
DATABASE_URL=postgresql://usuario:senha@host:5432/gestao_solar

# Chave de assinatura do JWT que o BFF emite para o app e para o painel.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
GS_JWT_SECRET=troque-isto

# Chave de cifra dos segredos guardados no banco (credenciais de serviço dos upstreams).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar esta chave torna ilegível o que já está gravado — as integrações precisam ser
# reconfiguradas pelo painel.
GS_ENCRYPTION_KEY=

# Ambiente: development | production. Em production o /docs é desligado e a ausência
# das chaves acima derruba o boot.
ENVIRONMENT=development

# --- Endereços padrão dos upstreams -----------------------------------------
# Servem só como sugestão inicial no painel. O que vale de verdade é o que o gestor
# configurar em /painel, que fica gravado no banco — inclusive a credencial de serviço,
# que NÃO mora mais aqui.
MEUWATT_API_URL=https://api.meuwatt.com.br
MEUPLANO_API_URL=https://api.meuplano.com.br

# URL do mw-fe usada pelo Chromium headless na geração de PDF (Fase 5)
MEUWATT_WEB_URL=https://app.meuwatt.com.br
