# Banco do BFF (Postgres). Em dev, cai para SQLite se não for definido.
DATABASE_URL=postgresql://usuario:senha@host:5432/gestao_solar

# Chave de assinatura do JWT que o BFF emite para o app.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
GS_JWT_SECRET=troque-isto

# --- meuWatt (mw-api) ---
MEUWATT_API_URL=https://api.meuwatt.com.br
MEUWATT_SERVICE_EMAIL=servico-gestao-solar@meuwatt.com.br
MEUWATT_SERVICE_PASSWORD=

# URL do mw-fe usada pelo Chromium headless na geração de PDF (Fase 5)
MEUWATT_WEB_URL=https://app.meuwatt.com.br

# --- meuPlano ---
MEUPLANO_API_URL=https://api.meuplano.com.br
MEUPLANO_SERVICE_EMAIL=servico-gestao-solar@meuplano.com.br
MEUPLANO_SERVICE_PASSWORD=

# Ambiente: development | production. Em production o /docs é desligado.
ENVIRONMENT=development
