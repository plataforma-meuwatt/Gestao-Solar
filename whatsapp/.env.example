# Gateway de WhatsApp — modelo do .env (o arquivo real não é versionado).
#
# As credenciais da Meta NÃO estão aqui: token, número, segredo do app e token de
# verificação são cadastrados na tela de administração do WhatsApp, no painel, e ficam
# cifrados no banco. O motivo é o mesmo das pontes com o meuWatt e o meuPlano: quem
# configura precisa testar, e segredo em variável de ambiente cobra um redeploy por
# tentativa.
#
# Em produção o serviço se recusa a subir sem WHATSAPP_CHAVE_INTERNA e
# GATEWAY_ENCRYPTION_KEY.

# ── banco ──────────────────────────────────────────────────────────────────
# Execução: modo TRANSAÇÃO do pooler do Supabase (porta 6543).
DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Alembic: modo SESSÃO (porta 5432) — ele mantém estado entre comandos.
DATABASE_URL_MIGRACAO=postgresql+psycopg2://USUARIO:SENHA@aws-0-us-west-1.pooler.supabase.com:5432/postgres
# A senha vai URL-ENCODED (`#` vira `%23`), senão chega truncada ao driver.

# ── segredos guardados ─────────────────────────────────────────────────────
# Fernet. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_ENCRYPTION_KEY=

# ── porta interna (quem chama é o BFF) ─────────────────────────────────────
WHATSAPP_CHAVE_INTERNA=
BFF_URL=https://gestao-solar-production.up.railway.app

# Versão da Graph. Subir é decisão de operação, por isso fica no ambiente e não na tela.
GRAPH_API_VERSION=v25.0

ENVIRONMENT=development
