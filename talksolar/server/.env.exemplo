# Talk Solar — copie para .env e preencha. Nada aqui vai para o git.

# O BANCO. Em producao: o MESMO Postgres do Supabase que o BFF do Gestao Solar usa - a
# mesma URL, inclusive a porta. O BFF roda no pooler :5432 (modo sessao), e e por ele que a
# configuracao ja esta provada nesta infraestrutura; :6543 e o pooler de transacao, que nao
# aceita prepared statement e cobra atencao extra do driver.
# As tabelas do Talk Solar tem prefixo ts_ e convivem com as do Gestao Solar.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Assina as sessoes. GERE UMA: python -c "import secrets;print(secrets.token_urlsafe(48))"
TALK_JWT_SECRET=
TALK_JWT_HORAS=12
TALK_SESSAO_DIAS=90

# Onde ficam os anexos: r2 (producao) | supabase (legado) | local (so para desenvolver -
# no Railway o disco e efemero e os anexos somem a cada deploy).
#
# A regra e da empresa, nao deste projeto (meuPlano/skills/onde-mora-cada-coisa.md):
# "linha de tabela -> Supabase; arquivo que alguem baixa -> R2". O criterio e EGRESS: o
# Supabase cobra banda de saida e ja suspendeu o Storage por cota (HTTP 402); o R2 nao
# cobra. Anexo de conversa e o caso extremo - foto que todo mundo baixa ao rolar a tela.
TALK_STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=talksolar
# DEIXE VAZIA: sem ela as URLs saem pre-assinadas e expiram em 1 h. Anexo de conversa
# interna atras de link publico eterno e vazamento.
R2_PUBLIC_BASE_URL=

# Legado, so se voce ja tiver anexos no Storage do Supabase.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# TALK_BUCKET=talksolar

# Quem pode abrir pelo navegador (lista separada por virgula). * so em desenvolvimento.
TALK_CORS=*

# Tetos
TALK_MAX_ARQUIVO_MB=25
TALK_MAX_ARQUIVOS=10
