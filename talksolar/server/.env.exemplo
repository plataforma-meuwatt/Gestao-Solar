# Talk Solar — copie para .env e preencha. Nada aqui vai para o git.

# O BANCO. Em producao: o Postgres do Supabase do Gestao Solar (use o pooler :6543).
# As tabelas do Talk Solar tem prefixo ts_ e convivem com as do Gestao Solar.
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Assina as sessoes. GERE UMA: python -c "import secrets;print(secrets.token_urlsafe(48))"
TALK_JWT_SECRET=
TALK_JWT_HORAS=12
TALK_SESSAO_DIAS=90

# Onde ficam os anexos. local = disco (SO para desenvolver: no Railway some a cada deploy).
TALK_STORAGE=supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
TALK_BUCKET=talksolar

# Quem pode abrir pelo navegador (lista separada por virgula). * so em desenvolvimento.
TALK_CORS=*

# Tetos
TALK_MAX_ARQUIVO_MB=25
TALK_MAX_ARQUIVOS=10
